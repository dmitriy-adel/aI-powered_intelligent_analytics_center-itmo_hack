# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Postgres (совпадает с docker-compose.yml)
PGHOST=localhost
PGPORT=5432
PGDATABASE=itmo_hack
PGUSER=postgres
PGPASSWORD=1

# Параллелизм LLM-запросов (опционально)
LLM_CONCURRENCY=4

# Модели OpenRouter по умолчанию (опционально, через запятую)
# LLM_MODELS=deepseek/deepseek-v4-flash

# Опционально: ключ LawAPI Госдумы (api.duma.gov.ru) для расширенного поиска законопроектов
# DUMA_API_TOKEN=
